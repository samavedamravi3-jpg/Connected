# Copy to server/.env (or set in your host's dashboard). Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...
# Required (app routes answer 503 without it). Must match EXPO_PUBLIC_ASSISTANT_TOKEN in the app's .env
APP_TOKEN=pick-any-long-random-string
PORT=8787
# Optional: free moderation provider (https://console.groq.com/keys). Without it, Claude does the AI check.
GROQ_API_KEY=
# Proxies in front of this server that append to x-forwarded-for (0 = none: the header is ignored). Usually 1 on a host.
TRUST_PROXY_HOPS=0
