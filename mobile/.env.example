# Copy to mobile/.env.local (ignored by git) to point the app at a specific backend.
# Leave unset in development: the app then uses the computer running `npx expo start`, port 5175
# (start the backend there with `npm run dev:lan` in the repo root, same Wi-Fi as the phone).
# For a deployed backend, e.g.:
# EXPO_PUBLIC_API_URL=https://connected.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_URL=
