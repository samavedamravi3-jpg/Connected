# Copy these names to an ignored .dev.vars file for local Worker development.
# Set production values through Sites environment variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mobile app API (email sign-in codes)
# AUTH_SECRET: long random string (e.g. `openssl rand -hex 32`). Required when deployed.
AUTH_SECRET=
# RESEND_API_KEY / MAIL_FROM: https://resend.com. Without a key, local dev shows the code in the API response.
RESEND_API_KEY=
MAIL_FROM=Connected <onboarding@resend.dev>
